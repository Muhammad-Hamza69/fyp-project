# Neuro-Flow — environment template
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Secrets below are stored as Windows User env vars during local dev; this file
# documents the full surface so nothing is undiscoverable.

# ---------- Database (Neon) ----------
# pooled connection -> FastAPI on Render
DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
# direct connection -> Celery worker (long transactions, no pooler)
DATABASE_URL_DIRECT=postgresql://...neon.tech/neondb?sslmode=require
NEON_ORG_ID=org-floral-resonance-34843312

# ---------- Object storage (Supabase Storage) ----------
# Replaces Cloudflare R2 — see docs/migration-plan.md "Object storage".
STORAGE_BACKEND=supabase           # supabase | local
SUPABASE_PROJECT_REF=cddhthsfeulazzsjaipu
SUPABASE_URL=https://cddhthsfeulazzsjaipu.supabase.co
SUPABASE_STORAGE_URL=https://cddhthsfeulazzsjaipu.supabase.co/storage/v1
SUPABASE_SERVICE_ROLE_KEY=         # server-side only, NEVER ship to the browser
SUPABASE_ANON_KEY=                 # safe for the browser
STORAGE_BUCKET_DATA=neuroflow-data      # private
STORAGE_BUCKET_ASSETS=neuroflow-assets  # public
# S3-compatible endpoint (optional boto3 path; needs dashboard-generated keys)
# SUPABASE_S3_ENDPOINT=https://cddhthsfeulazzsjaipu.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=ap-south-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# local backend root (used when STORAGE_BACKEND=local, e.g. `cli.py` offline runs)
STORAGE_LOCAL_ROOT=~/data/artifacts

# ---------- Auth (Clerk) ----------
CLERK_SECRET_KEY=                  # backend only
VITE_CLERK_PUBLISHABLE_KEY=        # baked into the JS bundle — public by design

# ---------- Queue (Upstash Redis) ----------
# Celery needs the wire protocol, NOT the Upstash REST API.
REDIS_URL=rediss://default:<password>@<host>:6379

# ---------- API <-> worker trust ----------
WORKER_HMAC_SECRET=                # signs POST /api/v1/internal/*
API_BASE_URL=https://<render-service>.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,https://<vercel-domain>

# ---------- Worker / CFD (WSL2) ----------
FOAM_CASE_ROOT=~/cases             # MUST be native ext4, never /mnt/d (9p is 10-50x slower)
FOAM_NPROC=6                       # physical cores, not logical
VENV_PYTHON=~/.venvs/neuroflow/bin/python
VMTK_ENV=vmtk                      # micromamba env (py3.9 — VMTK will not install on 3.12)
BLOOD_DENSITY=1060                 # kg/m^3  — also the WSS kinematic->Pa conversion factor
BLOOD_VISCOSITY=0.0035             # Pa*s

# ---------- Frontend (Vercel) ----------
# Everything VITE_* is world-readable in the bundle. No secrets here, ever.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_ASSET_BASE_URL=https://cddhthsfeulazzsjaipu.supabase.co/storage/v1/object/public/neuroflow-assets
