# --- credentials / local tool state (NEVER commit) ---
.env
.env.*
!.env.example
.vercel
.wrangler/
.supabase/
*.pem
*.key

# --- node / js ---
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- data & compute artifacts (large; object storage or local only) ---
data/
cases/
*.foam
*.vtu
*.vtp
*.stl
*.obj
*.nii
*.nii.gz

# ...but the upload-format fixtures ARE the test data, and excluding them meant
# CI could not run tests/formats.matrix.mjs at all: three of the eight files
# were missing on the runner, so the suite crashed on ENOENT while passing here.
# The rules above exist for CFD output, which is regenerable; these are not.
!test-uploads/
!test-uploads/**

# --- vm / archive images ---
*.vhdx
*.tar

# --- os / editor ---
.DS_Store
Thumbs.db

.vercel
.env*
